# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the Express server listens on
PORT=5000

# Supabase (or any hosted) PostgreSQL connection string, used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace_with_a_long_random_string"

# Sports data API key (e.g. TheSportsDB) — see PROGRESS.md for provider decision
SPORTS_API_KEY="123"

# AI API key (e.g. Gemini)
GEMINI_API_KEY=""

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173"
