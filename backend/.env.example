# MatchFusion Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Get from: https://supabase.com → Project → Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your actual Supabase DB password.
DATABASE_URL="postgresql://postgres.YOURREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ── Authentication ───────────────────────────────────────────────────────────
# Use a long random string in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_string_min_32_chars"

# ── Football API (API-Football) ───────────────────────────────────────────────
# Free plan: 100 requests/day.
# Sign up: https://dashboard.api-football.com/register
# After login, find your key at: https://dashboard.api-football.com/profile#api
API_FOOTBALL_KEY=""

# ── Cricket API (CricketData.org) ─────────────────────────────────────────────
# Free plan: 100 API calls/day. Data may lag real time.
# Sign up: https://cricketdata.org/pricing/
# After login, copy your API key from the dashboard.
CRICKETDATA_API_KEY=""

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Free tier available.
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional: override the default model (gemini-1.5-flash is free and fast)
# GEMINI_MODEL=gemini-1.5-flash

# ── Sports data refresh interval ─────────────────────────────────────────────
# How often the backend fetches fresh data from APIs (in minutes).
# Default: 30. Lower values use more of your free API quota.
# At 30 min: ~48 football calls/day + ~48 cricket calls/day = well within free limits.
SPORTS_REFRESH_INTERVAL_MINUTES=30
