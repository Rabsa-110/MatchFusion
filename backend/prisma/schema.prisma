// MatchFusion — Prisma schema
//
// Application data: accounts, community layer, and sports-data snapshots.
// Run after setting DATABASE_URL:
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())

  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
  votes        Vote[]
}

// ── Community ────────────────────────────────────────────────────────────────
model Post {
  id          String     @id @default(cuid())
  content     String
  matchTag    String?
  matchStatus String?    @default("ALL")
  createdAt   DateTime   @default(now())

  authorId    String
  author      User       @relation(fields: [authorId], references: [id])

  comments    Comment[]
  reactions   Reaction[]
  poll        Poll?
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  postId    String
  post      Post     @relation(fields: [postId], references: [id])
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("like")
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  postId    String
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId, type])
}

model Poll {
  id          String       @id @default(cuid())
  question    String
  matchStatus String?      @default("LIVE")
  matchId     String?
  createdAt   DateTime     @default(now())

  postId      String?      @unique
  post        Post?        @relation(fields: [postId], references: [id])

  options     PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  label  String

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])

  votes  Vote[]
}

model Vote {
  id       String     @id @default(cuid())

  userId   String
  user     User       @relation(fields: [userId], references: [id])

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id])

  @@unique([userId, optionId])
}

// ── Sports Data Snapshots ────────────────────────────────────────────────────
// Stores the latest normalized snapshot of each match fetched from external
// providers. Prevents redundant API calls; the refresh service upserts here.
model Match {
  id           String   @id @default(cuid())
  provider     String   // "football" | "cricket"
  externalId   String   // ID from the provider
  sport        String   // "football" | "cricket"
  competition  String
  status       String   // "LIVE" | "UPCOMING" | "COMPLETED" | "POSTPONED" | "CANCELLED"
  kickoffAt    DateTime?

  homeTeam     String
  homeShort    String
  homeLogo     String?
  awayTeam     String
  awayShort    String
  awayLogo     String?

  scoreHome    String?
  scoreAway    String?
  statusDetail String?  // minute, overs, result text etc.

  // JSON blobs for sport-specific extras (events, stats, cricket innings)
  eventsJson   String?  @default("[]")
  statsJson    String?
  extraJson    String?  // cricket: overs/wickets/innings; football: venue etc.

  lastFetchedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([sport, status])
  @@index([kickoffAt])
}
