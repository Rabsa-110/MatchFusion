// MatchFusion — Prisma schema
//
// Application data: accounts, community layer, and sports-data snapshots.
// Run migrations with:
//   npx prisma migrate dev --name <migration-name>
// NEVER run prisma migrate reset in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is used by `prisma migrate dev` (session pooler, supports DDL/migrations).
  directUrl = env("DIRECT_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())

  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
  votes        Vote[]
  polls        Poll[]
}

// ── Community ────────────────────────────────────────────────────────────────
model Post {
  id          String     @id @default(cuid())
  content     String
  matchTag    String?
  matchStatus String?    @default("ALL")
  createdAt   DateTime   @default(now())

  authorId    String
  author      User       @relation(fields: [authorId], references: [id])

  comments    Comment[]
  reactions   Reaction[]
  poll        Poll?
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("like")
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
}

model Poll {
  id          String       @id @default(cuid())
  question    String
  matchStatus String?      @default("ALL")
  matchId     String?      // References Match.externalId (not a FK, for flexibility)
  createdAt   DateTime     @default(now())

  // Optional post link
  postId      String?      @unique
  post        Post?        @relation(fields: [postId], references: [id])

  // Creator (nullable for backward compat with existing polls)
  creatorId   String?
  creator     User?        @relation(fields: [creatorId], references: [id])

  options     PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  label  String

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes  Vote[]
}

model Vote {
  id       String     @id @default(cuid())

  userId   String
  user     User       @relation(fields: [userId], references: [id])

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  pollId   String     // Denormalized for the unique per-poll constraint

  // One vote per user per poll (enforced at DB level)
  @@unique([userId, pollId])
  // Also prevent voting the same option twice (belt-and-suspenders)
  @@unique([userId, optionId])
}

// ── Sports Data Snapshots ────────────────────────────────────────────────────
// Stores the latest normalized snapshot of each match fetched from external
// providers. Prevents redundant API calls; the refresh service upserts here.
model Match {
  id           String   @id @default(cuid())
  provider     String   // "football" | "cricket"
  externalId   String   // ID from the provider
  sport        String   // "football" | "cricket"
  competition  String
  status       String   // "LIVE" | "UPCOMING" | "COMPLETED" | "POSTPONED" | "CANCELLED"
  kickoffAt    DateTime?

  homeTeam     String
  homeShort    String
  homeLogo     String?
  awayTeam     String
  awayShort    String
  awayLogo     String?

  scoreHome    String?
  scoreAway    String?
  statusDetail String?  // minute, overs, result text etc.

  // JSON blobs for sport-specific extras (events, stats, cricket innings)
  eventsJson   String?  @default("[]")
  statsJson    String?
  extraJson    String?  // cricket: overs/wickets/innings; football: venue etc.

  lastFetchedAt DateTime @default(now())

  aiInsights   AIInsight[]

  @@unique([provider, externalId])
  @@index([sport, status])
  @@index([kickoffAt])
}

// ── AI Insights ──────────────────────────────────────────────────────────────
// Persists AI-generated match insights to avoid repeated Gemini API calls.
model AIInsight {
  id           String   @id @default(cuid())
  matchId      String   // Match.id (internal cuid)
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  probHome     Float?
  probDraw     Float?
  probAway     Float?
  confidence   String   // "low" | "medium" | "high"
  method       String   // "result" | "live_score" | "neutral_baseline"
  explanation  String
  disclaimer   String
  factorsJson  String?  // JSON array of factor strings
  dataSnapshot String?  // JSON snapshot of input data used

  modelName    String   @default("gemini-2.5-flash")
  generatedAt  DateTime @default(now())
  expiresAt    DateTime // When to regenerate

  @@index([matchId])
  @@index([expiresAt])
}

// ── Team Directory ───────────────────────────────────────────────────────────
// Persists team information derived from match data and provider APIs.
model Team {
  id           String   @id @default(cuid())
  externalId   String?  // Provider-specific ID
  provider     String?  // "football" | "cricket"
  name         String
  shortName    String?
  country      String?
  sport        String   // "football" | "cricket"
  logo         String?
  competition  String?  // Primary competition
  lastUpdated  DateTime @default(now())

  players      Player[]

  @@unique([sport, name])
  @@index([sport])
}

// ── Player Directory ─────────────────────────────────────────────────────────
// Persists player information derived from match events and provider APIs.
// Only stores actual provider-supplied data — never fabricated statistics.
model Player {
  id           String   @id @default(cuid())
  externalId   String?  // Provider-specific ID
  provider     String?  // "football" | "cricket"
  name         String
  shortName    String?
  country      String?
  sport        String   // "football" | "cricket"
  position     String?  // football: Forward/Midfielder/Defender/Goalkeeper; cricket: Batsman/Bowler/etc.
  role         String?  // More detailed role description
  image        String?
  statsJson    String?  // Available statistics as JSON
  lastUpdated  DateTime @default(now())

  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])

  @@index([sport])
  @@index([name])
}
